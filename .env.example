# Demo mode needs no API key. Run commands with these variables exported.
COE_DATA_DIR=./var
COE_PROVIDER=demo
# Required only in bedrock mode; use AWS_PROFILE or a workload role, not hardcoded keys.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
# Set a long random token when running outside your own loopback interface.
COE_API_TOKEN=
